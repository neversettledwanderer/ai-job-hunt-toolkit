# Source of truth for these two values: YM_Vault/Projects/Active/job-hunt/.env
# (same values the Claude Code CLI uses via .mcp.json). If the key ever rotates,
# update it there first, then copy it here.

SUPABASE_JOB_HUNT_URL=https://your-project.supabase.co/functions/v1/job-hunt-mcp
SUPABASE_JOB_HUNT_KEY=your-opaque-access-key
