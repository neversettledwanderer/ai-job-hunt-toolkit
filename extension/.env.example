# Supabase (required for all features)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Gmail SMTP (optional, for email notifications)
# Create an App Password at https://myaccount.google.com/apppasswords
GMAIL_EMAIL=
GMAIL_APP_PASSWORD=

# Slack (optional, for Slack notifications)
# Create a Slack app at https://api.slack.com/apps
SLACK_BOT_TOKEN=
SLACK_CHANNEL=

# Weekly summary recipients (optional)
# Comma-separated email addresses. Defaults to GMAIL_EMAIL if not set.
WEEKLY_SUMMARY_RECIPIENTS=

# 1Password (optional, overrides .env for credential storage)
# If set, credentials are fetched from 1Password instead of .env values above
# OP_SERVICE_ACCOUNT_TOKEN=
# OP_VAULT_NAME=
# OP_SUPABASE_ITEM=
# OP_GMAIL_ITEM=
# OP_SLACK_ITEM=
