<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.jobhunt.daily-status</string>
  <key>ProgramArguments</key>
  <array>
    <!-- UPDATE THESE PATHS to match your installation -->
    <string>/path/to/ai-job-hunt-toolkit/extension/scripts/launchd-wrapper.sh</string>
    <string>/path/to/ai-job-hunt-toolkit/extension/scripts/daily-status.ts</string>
    <string>--mode</string>
    <string>daily</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>12</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/tmp/daily-status-kickoff.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/daily-status-kickoff.err</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <!-- UPDATE to your home directory -->
    <string>/Users/yourusername</string>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
</dict>
</plist>
